{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      { "command": "./hooks/protect-shell.sh" },
      {
        "command": "./hooks/secret-scan.sh",
        "matcher": "git\\s+(commit|push)\\b"
      }
    ],
    "beforeReadFile": [
      { "command": "./hooks/protect-read.sh" }
    ],
    "beforeTabFileRead": [
      { "command": "./hooks/protect-read.sh" }
    ],
    "preToolUse": [
      {
        "command": "./hooks/secret-scan.sh",
        "matcher": "Write|StrReplace"
      }
    ]
  }
}
