{
  "id": "destructive-confirm-force-push",
  "plugin": "security-core",
  "claim": "The destructive ops rule requires confirmation before force push.",
  "activation": "unknown",
  "target": { "file": "rules/040-destructive-ops.mdc", "section": "body" },
  "assert": {
    "type": "regex",
    "pattern": "confirm.*(force|git push --force)|git push --force",
    "flags": "i"
  }
}
