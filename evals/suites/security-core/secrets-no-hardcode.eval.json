{
  "id": "secrets-no-hardcode",
  "plugin": "security-core",
  "claim": "The secrets rule forbids hardcoding credentials and requires the project secret mechanism.",
  "activation": "unknown",
  "target": { "file": "rules/010-secrets.mdc", "section": "body" },
  "assert": {
    "type": "regex",
    "pattern": "hardcode|secret mechanism|never.*(password|token|api key)",
    "flags": "i"
  }
}
