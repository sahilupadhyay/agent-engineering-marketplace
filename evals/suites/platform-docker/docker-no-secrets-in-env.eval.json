{
  "id": "docker-no-secrets-in-env",
  "plugin": "platform-docker",
  "claim": "The Docker rule forbids secrets in ENV and host-network builds without asking.",
  "activation": "unknown",
  "target": {
    "file": "rules/010-docker-image-safety.mdc",
    "section": "body"
  },
  "assert": {
    "type": "regex",
    "pattern": "secrets in `ENV`|network=host",
    "flags": "i"
  }
}
