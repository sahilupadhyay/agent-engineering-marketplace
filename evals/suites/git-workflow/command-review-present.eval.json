{
  "id": "command-review-present",
  "plugin": "git-workflow",
  "claim": "review command exists with name frontmatter.",
  "activation": "unknown",
  "target": {
    "file": "commands/review.md",
    "section": "frontmatter"
  },
  "assert": {
    "type": "regex",
    "pattern": "name:\\s*review"
  }
}
