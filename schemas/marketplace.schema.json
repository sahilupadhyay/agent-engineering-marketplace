{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sahilupadhyay/agent-engineering-marketplace/schemas/marketplace.schema.json",
  "title": "Cursor marketplace manifest",
  "description": "Root .cursor-plugin/marketplace.json for a multi-plugin repository. See https://cursor.com/docs/reference/plugins",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "owner", "plugins"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
      "description": "Marketplace identifier (kebab-case)."
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "version": { "type": "string" },
        "pluginRoot": {
          "type": "string",
          "description": "Optional prefix path for all plugin source directories."
        }
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 0,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/pluginEntry" }
    }
  },
  "$defs": {
    "pluginEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable title shown in the Cursor plugin picker."
        },
        "source": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {
                "path": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "email": { "type": "string", "format": "email" }
          }
        },
        "homepage": { "type": "string", "format": "uri" },
        "repository": { "type": "string", "format": "uri" },
        "license": { "type": "string" },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "logo": { "type": "string" },
        "logoDark": {
          "type": "string",
          "description": "Relative path to logo asset for dark UI theme."
        },
        "category": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
